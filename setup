#!/usr/bin/env sh
# Detect the target user
if [ "$(whoami)" = "root" ]; then
    # Use SUDO_USER if available, otherwise default to root
    target_user=${SUDO_USER:-root}
else
    target_user=$(whoami)
fi

# Ensure the script is run as root
if [ "$(id -u)" -ne 0 ]; then
    echo "Running with sudo..."
    exec sudo "$0" "$target_user" "$@"
fi

echo "Installing AutoPull..."
# Check if the user is specified once the script is run with sudo
if [ $# -eq 1 ]; then
    target_user=$1
fi

AUTOPULL_PATH="$( cd "$( dirname "${BASH_SOURCE}" )" && pwd )"
chmod +x $AUTOPULL_PATH/autopull

if [ "$(which autopull)" ]; then
    rm "$(which autopull)"
fi
ln -s $AUTOPULL_PATH/autopull /usr/local/bin

autopull_repositories_path=$(eval echo ~$target_user)/.autopull_repositories
touch $autopull_repositories_path
chmod 777 $autopull_repositories_path

log_file=$(eval echo ~$target_user)/.autopull_logs
touch $log_file
chmod 777 $log_file

if [ -d "/proc/ish" ]; then
    for file in ${HOME}/.*shrc; do
        if [[ ! $file =~ ${HOME}/.!*shrc ]]; then
            RC_FILE="$file"
        fi
    done

    if [ -z "$RC_FILE" ]; then
        echo "No shell configuration file found"
        exit 1
    fi

    autopull_loop="(($AUTOPULL_PATH/autopull_loop &) &) >> $log_file 2>&1"
    if ! grep -q "$autopull_loop" "$RC_FILE"; then
        echo "Adding AutoPull to $RC_FILE"
        echo -e "# AutoPull\n$autopull_loop" >> "$RC_FILE"
    fi
    source $RC_FILE
elif [ "$(uname)" = "Darwin" ]; then
   if ! crontab -u "$target_user" -l | grep -q "$(which autopull) --all"; then
        (crontab -u "$target_user" -l 2>/dev/null; echo "# AutoPull"; echo "* * * * * $(which autopull) --all >/dev/null") | crontab -u "$target_user" -
    fi
else
    # Define variables for the service and timer
    APPLICATION_NAME="autopull"
    LAUNCH_PATH="$AUTOPULL_PATH/launch_files"
    SERVICE_FILE="$LAUNCH_PATH/linux_service"
    TIMER_FILE="$LAUNCH_PATH/linux_timer"
    SERVICE_NAME="$APPLICATION_NAME.service"
    TIMER_NAME="$APPLICATION_NAME.timer"
    SERVICE_PATH="/etc/systemd/system/$SERVICE_NAME"
    TIMER_PATH="/etc/systemd/system/$TIMER_NAME"

    resolved_content=""
    while IFS= read -r line || [ -n "$line" ]; do
        resolved_line=$(eval "echo \"$line\"")
        resolved_content="${resolved_content}${resolved_line}\n"
    done < "$SERVICE_FILE"

    # Add User directive to the service file
    echo $resolved_content > $SERVICE_PATH

    # Copy the timer file
    sudo cp $TIMER_FILE $TIMER_PATH

    # Reload systemd to recognize the new service and timer
    sudo systemctl daemon-reload

    # Enable and start the timer
    sudo systemctl enable $TIMER_NAME
    sudo systemctl start $TIMER_NAME

    # Check the status of the timer
    sudo systemctl status $TIMER_NAME
fi

echo "Autopull installed. To uninstall, run 'autopull --uninstall'."